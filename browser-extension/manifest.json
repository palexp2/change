{
  "manifest_version": 3,
  "name": "Orisha — Pont de session",
  "version": "1.9.1",
  "description": "Envoie à l'ERP Orisha les sessions ouvertes des portails fournisseurs et d'Instagram, lance la collecte des factures, et envoie le document affiché à l'extracteur. Fonctionne dans Edge comme dans Chrome.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "activeTab",
    "debugger",
    "contextMenus"
  ],
  "host_permissions": [
    "https://customer.orisha.io/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.com/*",
    "https://*.wix.com/*",
    "https://*.bell.ca/*",
    "https://*.digikey.ca/*",
    "https://*.simplexwireless.com/*",
    "https://*.fedex.com/*",
    "https://*.pishop.ca/*",
    "https://*.newark.com/*",
    "https://*.intuit.com/*",
    "https://*.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Orisha — Tout récolter"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "send-document": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Envoyer ce document à l'extracteur"
    }
  }
}
