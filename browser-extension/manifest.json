{
  "manifest_version": 3,
  "name": "Extension Boréal",
  "version": "1.18.0",
  "description": "Envoie à l'ERP Orisha les sessions ouvertes des portails fournisseurs et d'Instagram, lance la collecte des factures, envoie le document affiché à l'extracteur et des captures à Claude. Fonctionne dans Edge comme dans Chrome.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "activeTab",
    "debugger",
    "contextMenus",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://customer.orisha.io/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.com/*",
    "https://*.wix.com/*",
    "https://*.bell.ca/*",
    "https://*.digikey.ca/*",
    "https://*.simplexwireless.com/*",
    "https://*.fedex.com/*",
    "https://*.pishop.ca/*",
    "https://*.newark.com/*",
    "https://*.intuit.com/*",
    "https://*.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extension Boréal",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" }
    },
    "send-document": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Envoyer ce document à l'extracteur"
    }
  }
}
