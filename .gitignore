node_modules/
client/node_modules/
server/node_modules/
client/dist/
# Dossier de build temporaire et build précédent — deploy.sh construit dans
# .dist-build puis bascule par renommage, en gardant l'ancien un cycle.
client/.dist-build/
client/dist.prev/
*.db
*.db-shm
*.db-wal
.env
uploads/
server/data/
server/storage/
.agents/
.claude/
deploy.log

# Agent autonome — fichiers transitoires (le store .json reste versionné)
.agent-pid
.agent-pid-*
.agent-qpid-*
.agent-exec-*
agent-tasks.json.tmp
agent-backlog.json.tmp
agent-settings.json.tmp

# Env backups & variants (contain live secrets — never commit)
.env.*
server/.env*
!server/.env.example

# Artéfacts temporaires de mise au point (jamais versionnés)
_tmp_shot.js
server/logs-openai-check.log
server/src/scripts/tmp-qb-check.js
.last-deploy-commit
# Empreintes des sources du dernier déploiement — deploy.sh s'en sert pour ne
# rebuilder/redémarrer que ce qui a changé.
.deploy-fingerprints
